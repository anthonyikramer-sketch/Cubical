# Cubical environment configuration
# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local to version control.

# ── Store Catalog ─────────────────────────────────────────────────────────────
# Remote URL for the Cubical Store Catalog JSON.
# When unset, the client uses the bundled public/catalog.json as a fallback.
# In production, point this to your deployed catalog endpoint.
#
# Example (Replit deployment):
#   VITE_CATALOG_URL=https://your-api.replit.app/cubical/catalog.json
#
# Example (static hosting):
#   VITE_CATALOG_URL=https://cdn.example.com/cubical/catalog.json
#
# Example (local development server):
#   VITE_CATALOG_URL=http://localhost:8080/catalog.json
VITE_CATALOG_URL=

# ── Auto-updater (Electron desktop only) ─────────────────────────────────────
# Base URL of the release server for electron-updater (generic provider).
# The server must serve latest.yml alongside the installer artifacts.
# Ignored in browser preview and development mode.
#
# Example (GitHub Releases — use electron-builder's github provider instead):
#   CUBICAL_UPDATE_URL=https://github.com/your-org/cubical/releases/download/latest/
#
# Example (generic HTTPS):
#   CUBICAL_UPDATE_URL=https://releases.example.com/cubical/
#
# Example (Cloudflare R2 / object storage):
#   CUBICAL_UPDATE_URL=https://pub-xxx.r2.dev/cubical-releases/
CUBICAL_UPDATE_URL=
